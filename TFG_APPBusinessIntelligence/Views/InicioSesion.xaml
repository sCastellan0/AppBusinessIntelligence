<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TFG_APPBusinessIntelligence.Views.InicioSesion"
             Shell.NavBarIsVisible="False">
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1E3A8A" Offset="0.0" />
            <GradientStop Color="#0F172A" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <VerticalStackLayout Spacing="20" 
                     Padding="30" 
                     VerticalOptions="Center"
                     HorizontalOptions="Fill">

        <!-- Titulo -->
        <Label Text="INICIO DE SESION" 
            FontSize="28" 
            FontAttributes="Bold" 
            TextColor="White"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
            Margin="0,0,0,25"/>

        <!-- Etiqueta Correo -->
        <Label Text="Correo electrónico" 
            FontSize="14" 
            TextColor="White"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
            Margin="0,0,0,5"/>

        <!-- Campo de texto para Correo -->
        <Frame BackgroundColor="White" 
            BorderColor="#BDC3C7"
            CornerRadius="5"
            Padding="0"
            HasShadow="False">
            <Entry x:Name="UsuarioEntry"
                Placeholder="Ingrese su correo electrónico"
                PlaceholderColor="#BDC3C7"
                FontSize="14"
                BackgroundColor="Transparent"
                TextColor="#2C3E50"
                Margin="12,8"
                Keyboard="Email"/>
        </Frame>

        <!-- Etiqueta Contrasena -->
        <Label Text="Contrasena" 
            FontSize="14" 
            TextColor="White"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
            Margin="0,10,0,5"/>

        <!-- Campo de contrasena -->
        <Frame BackgroundColor="White" 
            BorderColor="#BDC3C7"
            CornerRadius="5"
            Padding="0"
            HasShadow="False">
            <Entry x:Name="ContrasenaEntry"
                Placeholder="Ingrese su contrasena"
                PlaceholderColor="#BDC3C7"
                FontSize="14"
                BackgroundColor="Transparent"
                TextColor="#2C3E50"
                Margin="12,8"
                IsPassword="True"/>
        </Frame>

        <!-- Botones Volver y Acceder -->
        <HorizontalStackLayout Spacing="10" 
                           HorizontalOptions="Center"
                           Margin="0,25,0,0">
            <!-- Boton Volver -->
            <Button Text="Volver" 
                 BackgroundColor="#95A5A6" 
                 TextColor="Red" 
                 FontSize="14"
                 CornerRadius="5"
                 WidthRequest="120"
                 Clicked="OnVolverClicked"/>

            <!-- Boton Acceder -->
            <Button Text="Acceder" 
                 BackgroundColor="#3498DB" 
                 TextColor="White" 
                 FontSize="14"
                 FontAttributes="Bold"
                 CornerRadius="5"
                 WidthRequest="120"
                 Clicked="OnAccederClicked"/>
        </HorizontalStackLayout>

    </VerticalStackLayout>

</ContentPage>