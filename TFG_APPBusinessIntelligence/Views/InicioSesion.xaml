<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TFG_APPBusinessIntelligence.Views.InicioSesion"
             Shell.NavBarIsVisible="False">
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1E3A8A" Offset="0.0" />
            <GradientStop Color="#0F172A" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <VerticalStackLayout Spacing="20" 
                     Padding="30" 
                     VerticalOptions="Center"
                     HorizontalOptions="Fill">

        <!-- Titulo -->
        <Label Text="INICIO DE SESION" 
            FontSize="28" 
            FontAttributes="Bold" 
            TextColor="White"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
            Margin="0,0,0,25"/>

        <!-- Etiqueta Correo -->
        <Label Text="Correo electrónico" 
            FontSize="14" 
            TextColor="White"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
            Margin="0,0,0,5"/>

        <!-- Campo de texto para Correo -->
        <Frame BackgroundColor="White" 
            BorderColor="#BDC3C7"
            CornerRadius="5"
            Padding="0"
            HasShadow="False">
            <Entry x:Name="UsuarioEntry"
                Placeholder="Ingrese su correo electrónico"
                PlaceholderColor="#BDC3C7"
                FontSize="14"
                BackgroundColor="Transparent"
                TextColor="#2C3E50"
                Margin="12,8"
                Keyboard="Email"/>
        </Frame>

        <!-- Etiqueta Contrasena -->
        <Label Text="Contrasena" 
            FontSize="14" 
            TextColor="White"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
            Margin="0,10,0,5"/>

        <!-- Campo de contrasena -->
        <Frame BackgroundColor="White" 
            BorderColor="#BDC3C7"
            CornerRadius="5"
            Padding="0"
            HasShadow="False">
            <Entry x:Name="ContrasenaEntry"
                Placeholder="Ingrese su contrasena"
                PlaceholderColor="#BDC3C7"
                FontSize="14"
                BackgroundColor="Transparent"
                TextColor="#2C3E50"
                Margin="12,8"
                IsPassword="True"/>
        </Frame>

        <!-- Botones Volver y Acceder -->
        <HorizontalStackLayout Spacing="10" 
                           HorizontalOptions="Center"
                           Margin="0,25,0,0">
            <!-- Boton Volver -->
            <Button Text="Volver" 
                 BackgroundColor="#95A5A6" 
                 TextColor="Red" 
                 FontSize="14"
                 CornerRadius="5"
                 WidthRequest="120"
                 Clicked="OnVolverClicked"/>

            <!-- Boton Acceder -->
            <Button Text="Acceder" 
                 BackgroundColor="#3498DB" 
                 TextColor="White" 
                 FontSize="14"
                 FontAttributes="Bold"
                 CornerRadius="5"
                 WidthRequest="120"
                 Clicked="OnAccederClicked"/>
        </HorizontalStackLayout>

        <!-- Banner de error de login -->
        <Border x:Name="ErrorBanner"
                IsVisible="False"
                BackgroundColor="#7F1D1D"
                StrokeShape="RoundRectangle 10"
                Stroke="#EF4444"
                StrokeThickness="1"
                Padding="14,10">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Label Grid.Column="0" Text="⚠️" FontSize="18" VerticalOptions="Center"/>
                <Label x:Name="ErrorBannerLabel"
                       Grid.Column="1"
                       Text=""
                       TextColor="White"
                       FontSize="14"
                       VerticalOptions="Center"/>
                <Label Grid.Column="2"
                       Text="✕"
                       TextColor="#FCA5A5"
                       FontSize="16"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCerrarErrorTapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
        </Border>

        <!-- Enlace recuperar contraseña -->
        <Label Text="¿Olvidaste tu contraseña?"
               FontSize="13"
               TextColor="#93C5FD"
               HorizontalOptions="Center"
               TextDecorations="Underline"
               Margin="0,8,0,0">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnRecuperarContrasenaTapped"/>
            </Label.GestureRecognizers>
        </Label>

    </VerticalStackLayout>

</ContentPage>
