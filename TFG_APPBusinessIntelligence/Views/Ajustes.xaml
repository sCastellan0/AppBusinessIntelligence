<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TFG_APPBusinessIntelligence.Views.Ajustes"
             Shell.NavBarIsVisible="False">
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{DynamicResource TemaGradienteInicio}" Offset="0.0" />
            <GradientStop Color="{DynamicResource TemaGradienteFin}" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toast carpeta guardada -->
        <Border x:Name="ToastCarpeta"
                Grid.RowSpan="2"
                BackgroundColor="#1E4620"
                StrokeShape="RoundRectangle 14"
                Stroke="#2D6A30"
                StrokeThickness="1"
                Padding="16,12"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="0,0,0,28"
                Opacity="0"
                IsVisible="False"
                ZIndex="10">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Label Grid.Column="0"
                       Text="✅"
                       FontSize="20"
                       VerticalOptions="Center"/>
                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                    <Label Text="Carpeta guardada"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="White"/>
                    <Label x:Name="ToastCarpetaRuta"
                           FontSize="11"
                           TextColor="#A7F3A0"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Cabecera -->
        <Grid Grid.Row="0" Margin="0,20,0,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0"
                   Text="←"
                   FontSize="28"
                   TextColor="White"
                   VerticalOptions="Center"
                   Margin="0,0,12,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVolverTapped" />
                </Label.GestureRecognizers>
            </Label>

            <Label Grid.Column="1"
                   Text="Ajustes"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center"/>
        </Grid>

        <!-- Opciones -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Spacing="14" Padding="0,0,0,20">

            <!-- Sección Apariencia -->
            <Label Text="APARIENCIA"
                   FontSize="11"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource TemaAccent}"
                   Margin="4,0,0,4"
                   CharacterSpacing="2"/>

            <!-- Tarjeta Tema -->
            <Frame BackgroundColor="{DynamicResource TemaTarjeta}"
                   BorderColor="{DynamicResource TemaBorde}"
                   CornerRadius="12"
                   Padding="16"
                   HasShadow="False">
                <VerticalStackLayout Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0"
                               Text="🎨"
                               FontSize="30"
                               VerticalOptions="Center"
                               Margin="0,0,14,0"/>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Tema de la app"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="White"/>
                            <Label x:Name="EstadoTemaLabel"
                                   FontSize="12"
                                   TextColor="{DynamicResource TemaSubtexto}"/>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Botones de selección de tema -->
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnTemaOscuro"
                                Grid.Column="0"
                                Text="🌙 Oscuro"
                                FontSize="13"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                HeightRequest="42"
                                Clicked="OnTemaOscuroClicked"/>

                        <Button x:Name="BtnTemaAzulClaro"
                                Grid.Column="1"
                                Text="☀️ Azul claro"
                                FontSize="13"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                HeightRequest="42"
                                Clicked="OnTemaAzulClaroClicked"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Sección Notificaciones -->
            <Label Text="NOTIFICACIONES"
                   FontSize="11"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource TemaAccent}"
                   Margin="4,0,0,4"
                   CharacterSpacing="2"/>

            <!-- Tarjeta Notificaciones -->
            <Frame BackgroundColor="{DynamicResource TemaTarjeta}"
                   BorderColor="{DynamicResource TemaBorde}"
                   CornerRadius="12"
                   Padding="16"
                   HasShadow="False">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0"
                           Text="🔔"
                           FontSize="30"
                           VerticalOptions="Center"
                           Margin="0,0,14,0"/>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="Notificaciones"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="White"/>
                        <Label x:Name="EstadoNotifLabel"
                               FontSize="12"
                               TextColor="{DynamicResource TemaSubtexto}"/>
                    </VerticalStackLayout>

                    <Switch x:Name="NotifSwitch"
                            Grid.Column="2"
                            VerticalOptions="Center"
                            OnColor="#3B82F6"
                            ThumbColor="White"
                            Toggled="OnNotifToggled"/>
                </Grid>
            </Frame>

            <!-- Tarjeta Almacenamiento -->
            <Frame BackgroundColor="{DynamicResource TemaTarjeta}"
                   BorderColor="{DynamicResource TemaBorde}"
                   CornerRadius="12"
                   Padding="16"
                   HasShadow="False">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0"
                           Text="📁"
                           FontSize="30"
                           VerticalOptions="Center"
                           Margin="0,0,14,0"/>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="Almacenamiento"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="White"/>
                        <Label x:Name="EstadoAlmacenLabel"
                               FontSize="12"
                               TextColor="{DynamicResource TemaSubtexto}"/>
                    </VerticalStackLayout>

                    <Switch x:Name="AlmacenSwitch"
                            Grid.Column="2"
                            VerticalOptions="Center"
                            OnColor="#3B82F6"
                            ThumbColor="White"
                            Toggled="OnAlmacenToggled"/>
                </Grid>
            </Frame>

            <!-- Sección Informes -->
            <Label Text="INFORMES"
                   FontSize="11"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource TemaAccent}"
                   Margin="4,0,0,4"
                   CharacterSpacing="2"/>

            <!-- Tarjeta carpeta de informes -->
            <Frame BackgroundColor="{DynamicResource TemaTarjeta}"
                   BorderColor="{DynamicResource TemaBorde}"
                   CornerRadius="12"
                   Padding="16"
                   HasShadow="False">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSeleccionarCarpetaInformesTapped" />
                </Frame.GestureRecognizers>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0"
                           Text="📂"
                           FontSize="30"
                           VerticalOptions="Center"
                           Margin="0,0,14,0"/>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="Carpeta de informes PDF"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="White"/>
                        <Label x:Name="CarpetaInformesLabel"
                               Text="No configurada"
                               FontSize="12"
                               TextColor="{DynamicResource TemaSubtexto}"
                               LineBreakMode="TailTruncation"/>
                    </VerticalStackLayout>

                    <Label Grid.Column="2"
                           Text="›"
                           FontSize="24"
                           TextColor="{DynamicResource TemaAccentOscuro}"
                           VerticalOptions="Center"/>
                </Grid>
            </Frame>

            <!-- Sección Seguridad -->
            <Label Text="SEGURIDAD"
                   FontSize="11"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource TemaAccent}"
                   Margin="4,0,0,4"
                   CharacterSpacing="2"/>

            <!-- Tarjeta 2FA -->
            <Frame BackgroundColor="{DynamicResource TemaTarjeta}"
                   BorderColor="{DynamicResource TemaBorde}"
                   CornerRadius="12"
                   Padding="16"
                   HasShadow="False">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnConfigurar2FATapped" />
                </Frame.GestureRecognizers>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0"
                           Text="🔐"
                           FontSize="30"
                           VerticalOptions="Center"
                           Margin="0,0,14,0"/>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="Verificación en dos pasos (2FA)"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="White"/>
                        <Label x:Name="Estado2FALabel"
                               FontSize="12"
                               TextColor="{DynamicResource TemaSubtexto}"/>
                    </VerticalStackLayout>

                    <Label Grid.Column="2"
                           Text="›"
                           FontSize="24"
                           TextColor="{DynamicResource TemaAccentOscuro}"
                           VerticalOptions="Center"/>
                </Grid>
            </Frame>

            <!-- Tarjeta Cambiar contraseña -->
            <Frame BackgroundColor="{DynamicResource TemaTarjeta}"
                   BorderColor="{DynamicResource TemaBorde}"
                   CornerRadius="12"
                   Padding="16"
                   HasShadow="False">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCambiarContrasenaTapped" />
                </Frame.GestureRecognizers>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0"
                           Text="🔒"
                           FontSize="30"
                           VerticalOptions="Center"
                           Margin="0,0,14,0"/>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="Cambiar contraseña"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="White"/>
                        <Label Text="Actualiza tu contraseña de acceso"
                               FontSize="12"
                               TextColor="{DynamicResource TemaSubtexto}"/>
                    </VerticalStackLayout>

                    <Label Grid.Column="2"
                           Text="›"
                           FontSize="24"
                           TextColor="{DynamicResource TemaAccentOscuro}"
                           VerticalOptions="Center"/>
                </Grid>
            </Frame>

        </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
