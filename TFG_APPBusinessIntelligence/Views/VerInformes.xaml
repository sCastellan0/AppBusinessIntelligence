<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TFG_APPBusinessIntelligence.Views.VerInformes"
             Title=""
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{DynamicResource TemaGradienteInicio}" Offset="0.0" />
            <GradientStop Color="{DynamicResource TemaGradienteFin}"   Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Grid Grid.Row="0" Margin="0,20,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- BOTÓN DE VOLVER (CORREGIDO) -->
            <Button Grid.Column="0"
                    Text="←"
                    Clicked="OnVolverTapped"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontSize="28"
                    Padding="0"
                    BorderWidth="0"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    Margin="0,0,12,0" />

            <Label Grid.Column="1"
                   Text="📄 Informes PDF"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center" />
        </Grid>

        <!-- Lista de PDFs -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12">

                <!-- Sin PDFs -->
                <VerticalStackLayout x:Name="SinPdfsLayout"
                                     IsVisible="False"
                                     Spacing="8"
                                     Margin="0,40,0,0">
                    <Label Text="📭"
                           FontSize="48"
                           HorizontalOptions="Center" />
                    <Label Text="No se encontraron PDFs en esta carpeta"
                           FontSize="14"
                           TextColor="White"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- CollectionView PDFs -->
                <CollectionView x:Name="ListaPdfs"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BackgroundColor="{DynamicResource TemaTarjeta}"
                                   BorderColor="{DynamicResource TemaBorde}"
                                   CornerRadius="12"
                                   Padding="16,12"
                                   HasShadow="True"
                                   Margin="0,0,0,4">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                    <Label Grid.Column="0"
                                           Text="📄"
                                           FontSize="28"
                                           VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Nombre}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Detalle}"
                                               FontSize="11"
                                               TextColor="#94A3B8" />
                                    </VerticalStackLayout>

                                    <!-- Botón abrir -->
                                    <Label Grid.Column="2"
                                           Text="▶"
                                           FontSize="16"
                                           TextColor="#4A6FA5"
                                           VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer CommandParameter="{Binding .}"
                                                                  Tapped="OnPdfTapped" />
                                        </Label.GestureRecognizers>
                                    </Label>

                                    <!-- Botón eliminar -->
                                    <Label Grid.Column="3"
                                           Text="🗑"
                                           FontSize="18"
                                           TextColor="#EF4444"
                                           VerticalOptions="Center"
                                           Margin="4,0,0,0">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer CommandParameter="{Binding .}"
                                                                  Tapped="OnEliminarPdfTapped" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Overlay confirmación borrado -->
        <Grid x:Name="OverlayEliminar"
              Grid.RowSpan="2"
              IsVisible="False"
              BackgroundColor="Transparent"
              ZIndex="10">
            <Border BackgroundColor="{DynamicResource TemaTarjeta}"
                    StrokeShape="RoundRectangle 18"
                    Stroke="{DynamicResource TemaBorde}"
                    StrokeThickness="1"
                    Padding="28,24"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="320"
                    Shadow="{Shadow Brush=#33000000, Offset='0,8', Radius=20}">
                <VerticalStackLayout Spacing="16">

                    <Border BackgroundColor="#FEE2E2"
                            StrokeShape="RoundRectangle 40"
                            StrokeThickness="0"
                            WidthRequest="56" HeightRequest="56"
                            HorizontalOptions="Center">
                        <Label Text="🗑"
                               FontSize="26"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <Label Text="Eliminar informe"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center" />

                    <Label x:Name="OverlayMensaje"
                           FontSize="13"
                           TextColor="#94A3B8"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,6,0,0">

                        <Border Grid.Column="0"
                                BackgroundColor="Transparent"
                                StrokeShape="RoundRectangle 10"
                                Stroke="{DynamicResource TemaBorde}"
                                StrokeThickness="1"
                                Padding="0,12">
                            <Label Text="Cancelar"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnOverlayCancelar" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Border>

                        <Border Grid.Column="1"
                                BackgroundColor="#EF4444"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="0"
                                Padding="0,12">
                            <Label Text="Eliminar"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnOverlayConfirmar" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Border>

                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
