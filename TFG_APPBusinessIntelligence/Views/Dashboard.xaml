<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TFG_APPBusinessIntelligence.Views.Dashboard"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{DynamicResource TemaGradienteInicio}" Offset="0.0" />
            <GradientStop Color="{DynamicResource TemaGradienteFin}" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Barra superior con iconos -->
        <Grid Grid.Row="0" Margin="0,20,0,40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Icono de configuración (izquierda) -->
            <HorizontalStackLayout Grid.Column="0" Spacing="10">
                <Label Text="⚙"
                       FontSize="30"
                       TextColor="White"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnConfiguracionTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

            <!-- Icono de salir (derecha) -->
            <Image Grid.Column="1"
                   Source="logout_icon.svg"
                   WidthRequest="32"
                   HeightRequest="32"
                   VerticalOptions="Center">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSalirTapped" />
                </Image.GestureRecognizers>
            </Image>
        </Grid>

        <!-- Contenido central -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20"
                                VerticalOptions="Center"
                                HorizontalOptions="Fill"
                                Padding="0,10,0,20">

                <!-- Titulo de bienvenida -->
                <Label Text="Bienvenido a&#x0a;ANALYSTIX" 
                       FontSize="28" 
                       FontAttributes="Bold" 
                       TextColor="White"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"/>

                <!-- Subtitulo -->
                <Label Text="Introduce los datos que&#x0a;quieras ver&#x0a;detalladamente" 
                       FontSize="16" 
                       TextColor="White"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"
                       Margin="0,0,0,10"/>

                <!-- Icono de carpeta con lupa -->
                <Grid WidthRequest="180" 
                      HeightRequest="180"
                      HorizontalOptions="Center"
                      Margin="0,10,0,10">

                    <!-- Carpeta -->
                    <Frame BackgroundColor="#34558B"
                           BorderColor="#4A6FA5"
                           CornerRadius="10"
                           Padding="15"
                           HasShadow="True"
                           WidthRequest="160"
                           HeightRequest="120"
                           VerticalOptions="Start"
                           HorizontalOptions="Center">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCarpetaTapped" />
                        </Frame.GestureRecognizers>
                        <Label Text="📁" 
                               FontSize="50" 
                               TextColor="#5A7FA5"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Frame>

                    <!-- Lupa con signo + -->
                    <Frame BackgroundColor="#E74C3C"
                           BorderColor="#C0392B"
                           CornerRadius="35"
                           Padding="0"
                           HasShadow="True"
                           WidthRequest="70"
                           HeightRequest="70"
                           VerticalOptions="End"
                           HorizontalOptions="End"
                           Margin="0,0,15,0">
                        <Grid>
                            <Label Text="🔍" 
                                   FontSize="30" 
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Margin="0,0,5,5"/>
                            <Label Text="+" 
                                   FontSize="25" 
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Margin="12,12,0,0"/>
                        </Grid>
                    </Frame>
                </Grid>

                <!-- Mensaje inferior -->
                <Label Text="¡Ya tienes datos, revisalos!" 
                       FontSize="15" 
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Margin="0,10,0,0"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Botón Ver datos -->
        <Button Grid.Row="2"
                Text="Ver datos" 
                BackgroundColor="#4A6FA5" 
                TextColor="White" 
                FontSize="16"
                FontAttributes="Bold"
                CornerRadius="8"
                HeightRequest="45"
                HorizontalOptions="Center"
                WidthRequest="180"
                Margin="0,0,0,30"
                Clicked="OnVerDatosClicked"/>

        <!-- Panel de confirmación cerrar sesión -->
        <Border x:Name="PanelSalir"
                Grid.RowSpan="3"
                IsVisible="False"
                StrokeShape="RoundRectangle 20,20,0,0"
                Stroke="Transparent"
                StrokeThickness="0"
                Padding="28,24,28,36"
                VerticalOptions="End"
                TranslationY="300">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1E3A8A" Offset="0.0" />
                    <GradientStop Color="#0F172A" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <VerticalStackLayout Spacing="20">

                <!-- Icono -->
                <Image Source="logout_icon.svg"
                       WidthRequest="56"
                       HeightRequest="56"
                       HorizontalOptions="Center"/>

                <!-- Título -->
                <Label Text="Cerrar sesión"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"/>

                <!-- Mensaje -->
                <Label Text="¿Estás seguro de que quieres salir de tu cuenta?"
                       FontSize="14"
                       TextColor="#93C5FD"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>

                <!-- Botones -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                    <Border Grid.Column="0"
                            BackgroundColor="Transparent"
                            StrokeShape="RoundRectangle 10"
                            Stroke="#4A6FA5"
                            StrokeThickness="1.5"
                            Padding="0,14">
                        <Label Text="Cancelar"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="#93C5FD"
                               HorizontalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCancelarSalirTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>
                    <Border Grid.Column="1"
                            BackgroundColor="#EF4444"
                            StrokeShape="RoundRectangle 10"
                            Stroke="#EF4444"
                            StrokeThickness="0"
                            Padding="0,14">
                        <Label Text="Sí, salir"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnConfirmarSalirTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>
                </Grid>

            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>
