<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TFG_APPBusinessIntelligence.Views.Configuracion2FA"
             Shell.NavBarIsVisible="False">
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1E3A8A" Offset="0.0" />
            <GradientStop Color="#0F172A" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Spacing="16"
                             Padding="30"
                             VerticalOptions="Center"
                             HorizontalOptions="Fill">

            <!-- Título -->
            <Label Text="Configurar verificación 2FA"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,5"/>

            <!-- Estado 2FA -->
            <Frame x:Name="EstadoFrame"
                   BackgroundColor="#1E40AF"
                   BorderColor="#3B82F6"
                   CornerRadius="8"
                   Padding="12">
                <Label x:Name="EstadoLabel"
                       FontSize="14"
                       TextColor="White"
                       HorizontalTextAlignment="Center"/>
            </Frame>

            <!-- Panel de activación (visible cuando 2FA está desactivado) -->
            <VerticalStackLayout x:Name="PanelActivacion" Spacing="12" IsVisible="False">

                <Label Text="Escanea este código QR con Google Authenticator o Microsoft Authenticator:"
                       FontSize="13"
                       TextColor="#BDC3C7"
                       HorizontalTextAlignment="Center"/>

                <!-- Código QR -->
                <Frame BackgroundColor="White"
                       CornerRadius="8"
                       Padding="12"
                       HorizontalOptions="Center">
                    <Image x:Name="CodigoQR"
                           WidthRequest="220"
                           HeightRequest="220"/>
                </Frame>

                <!-- Secret manual -->
                <Label Text="O introduce esta clave manualmente:"
                       FontSize="12"
                       TextColor="#BDC3C7"
                       HorizontalTextAlignment="Center"/>

                <Frame BackgroundColor="#1E293B"
                       BorderColor="#3B82F6"
                       CornerRadius="5"
                       Padding="10">
                    <Label x:Name="SecretLabel"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#60A5FA"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="CharacterWrap"/>
                </Frame>

                <!-- Confirmación del código -->
                <Label Text="Introduce el código de tu app para confirmar la activación:"
                       FontSize="13"
                       TextColor="White"
                       HorizontalTextAlignment="Center"
                       Margin="0,8,0,0"/>

                <Frame BackgroundColor="White"
                       BorderColor="#BDC3C7"
                       CornerRadius="5"
                       Padding="0"
                       HasShadow="False">
                    <Entry x:Name="CodigoConfirmacionEntry"
                           Placeholder="Código de 6 dígitos"
                           PlaceholderColor="#BDC3C7"
                           FontSize="20"
                           FontAttributes="Bold"
                           BackgroundColor="Transparent"
                           TextColor="#2C3E50"
                           HorizontalTextAlignment="Center"
                           Margin="12,8"
                           Keyboard="Numeric"
                           MaxLength="6"/>
                </Frame>

                <Button Text="Activar 2FA"
                        BackgroundColor="#22C55E"
                        TextColor="White"
                        FontSize="14"
                        FontAttributes="Bold"
                        CornerRadius="5"
                        Clicked="OnActivarClicked"/>
            </VerticalStackLayout>

            <!-- Panel de desactivación (visible cuando 2FA está activo) -->
            <VerticalStackLayout x:Name="PanelDesactivacion" Spacing="12" IsVisible="False">
                <Label Text="Introduce tu código actual para desactivar el 2FA:"
                       FontSize="13"
                       TextColor="White"
                       HorizontalTextAlignment="Center"/>

                <Frame BackgroundColor="White"
                       BorderColor="#BDC3C7"
                       CornerRadius="5"
                       Padding="0"
                       HasShadow="False">
                    <Entry x:Name="CodigoDesactivarEntry"
                           Placeholder="Código de 6 dígitos"
                           PlaceholderColor="#BDC3C7"
                           FontSize="20"
                           FontAttributes="Bold"
                           BackgroundColor="Transparent"
                           TextColor="#2C3E50"
                           HorizontalTextAlignment="Center"
                           Margin="12,8"
                           Keyboard="Numeric"
                           MaxLength="6"/>
                </Frame>

                <Button Text="Desactivar 2FA"
                        BackgroundColor="#EF4444"
                        TextColor="White"
                        FontSize="14"
                        FontAttributes="Bold"
                        CornerRadius="5"
                        Clicked="OnDesactivarClicked"/>
            </VerticalStackLayout>

            <!-- Botón volver -->
            <Button Text="Volver"
                    BackgroundColor="#95A5A6"
                    TextColor="White"
                    FontSize="14"
                    CornerRadius="5"
                    Margin="0,10,0,0"
                    Clicked="OnVolverClicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
