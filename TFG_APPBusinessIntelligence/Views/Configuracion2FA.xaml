<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TFG_APPBusinessIntelligence.Views.Configuracion2FA"
             Shell.NavBarIsVisible="False">
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{DynamicResource TemaGradienteInicio}" Offset="0.0" />
            <GradientStop Color="{DynamicResource TemaGradienteFin}" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Spacing="16"
                             Padding="30"
                             VerticalOptions="Center"
                             HorizontalOptions="Fill">

            <!-- Título -->
            <Label Text="Configurar verificación 2FA"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,5"/>

            <!-- Estado 2FA -->
            <Frame x:Name="EstadoFrame"
                   BackgroundColor="#1E40AF"
                   BorderColor="#3B82F6"
                   CornerRadius="8"
                   Padding="12">
                <Label x:Name="EstadoLabel"
                       FontSize="14"
                       TextColor="White"
                       HorizontalTextAlignment="Center"/>
            </Frame>

            <!-- Panel de activación (visible cuando 2FA está desactivado) -->
            <VerticalStackLayout x:Name="PanelActivacion" Spacing="12" IsVisible="False">

                <Label Text="Introduce esta clave en Microsoft Authenticator:"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalTextAlignment="Center"
                       Margin="0,10,0,5"/>

                <!-- Instrucciones -->
                <Label HorizontalTextAlignment="Center"
                       TextColor="#BDC3C7"
                       FontSize="12"
                       Margin="0,0,0,10">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="1. Abre Microsoft Authenticator&#x0a;"/>
                            <Span Text="2. Toca + → Otra cuenta (Google, Facebook, etc.)&#x0a;"/>
                            <Span Text="3. Introduce esta clave:"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!-- Secret manual con botón copiar -->
                <Frame BackgroundColor="{DynamicResource TemaTarjeta}"
                       BorderColor="#3B82F6"
                       CornerRadius="5"
                       Padding="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label x:Name="SecretLabel"
                               Grid.Column="0"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TemaAccent}"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"
                               LineBreakMode="CharacterWrap"/>
                        <Button Grid.Column="1"
                                Text="📋"
                                FontSize="20"
                                Clicked="OnCopiarSecretClicked"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource TemaAccent}"
                                WidthRequest="50"
                                HeightRequest="40"
                                Padding="0"/>
                    </Grid>
                </Frame>

                <!-- Configuración -->
                <Label HorizontalTextAlignment="Center"
                       TextColor="#94A3B8"
                       FontSize="11"
                       Margin="0,0,0,5">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Configuración: "/>
                            <Span Text="Basada en tiempo • SHA1 • 6 dígitos" FontAttributes="Bold"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!-- Confirmación del código -->
                <Label Text="Introduce el código de 6 dígitos que aparece en la app:"
                       FontSize="13"
                       TextColor="White"
                       HorizontalTextAlignment="Center"
                       Margin="0,15,0,0"/>

                <Frame BackgroundColor="White"
                       BorderColor="#BDC3C7"
                       CornerRadius="5"
                       Padding="0"
                       HasShadow="False">
                    <Entry x:Name="CodigoConfirmacionEntry"
                           Placeholder="Código de 6 dígitos"
                           PlaceholderColor="#BDC3C7"
                           FontSize="20"
                           FontAttributes="Bold"
                           BackgroundColor="Transparent"
                           TextColor="#2C3E50"
                           HorizontalTextAlignment="Center"
                           Margin="12,8"
                           Keyboard="Numeric"
                           MaxLength="6"/>
                </Frame>

                <Button Text="Activar 2FA"
                        BackgroundColor="#22C55E"
                        TextColor="White"
                        FontSize="14"
                        FontAttributes="Bold"
                        CornerRadius="5"
                        Margin="0,10,0,0"
                        Clicked="OnActivarClicked"/>
            </VerticalStackLayout>

            <!-- Panel de desactivación (visible cuando 2FA está activo) -->
            <VerticalStackLayout x:Name="PanelDesactivacion" Spacing="12" IsVisible="False">
                <Label Text="Introduce tu código actual para desactivar el 2FA:"
                       FontSize="13"
                       TextColor="White"
                       HorizontalTextAlignment="Center"/>

                <Frame BackgroundColor="White"
                       BorderColor="#BDC3C7"
                       CornerRadius="5"
                       Padding="0"
                       HasShadow="False">
                    <Entry x:Name="CodigoDesactivarEntry"
                           Placeholder="Código de 6 dígitos"
                           PlaceholderColor="#BDC3C7"
                           FontSize="20"
                           FontAttributes="Bold"
                           BackgroundColor="Transparent"
                           TextColor="#2C3E50"
                           HorizontalTextAlignment="Center"
                           Margin="12,8"
                           Keyboard="Numeric"
                           MaxLength="6"/>
                </Frame>

                <Button Text="Desactivar 2FA"
                        BackgroundColor="#EF4444"
                        TextColor="White"
                        FontSize="14"
                        FontAttributes="Bold"
                        CornerRadius="5"
                        Clicked="OnDesactivarClicked"/>
            </VerticalStackLayout>

            <!-- Botón volver -->
            <Button Text="Volver"
                    BackgroundColor="{DynamicResource TemaTarjeta}"
                    TextColor="{DynamicResource TemaAccent}"
                    FontSize="14"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="46"
                    Margin="0,10,0,0"
                    Clicked="OnVolverClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
