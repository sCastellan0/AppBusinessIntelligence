<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TFG_APPBusinessIntelligence.Views.RecuperarContrasena"
             Shell.NavBarIsVisible="False">
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1E3A8A" Offset="0.0" />
            <GradientStop Color="#0F172A" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <VerticalStackLayout Spacing="20"
                         Padding="30"
                         VerticalOptions="Center"
                         HorizontalOptions="Fill">

        <!-- Icono -->
        <Label Text="🔑"
               FontSize="52"
               HorizontalOptions="Center"/>

        <!-- Título -->
        <Label Text="Recuperar contraseña"
               FontSize="24"
               FontAttributes="Bold"
               TextColor="White"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"/>

        <!-- Descripción -->
        <Label Text="Introduce tu correo electrónico y te enviaremos un enlace para restablecer tu contraseña."
               FontSize="14"
               TextColor="#BDC3C7"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               Margin="0,0,0,10"/>

        <!-- Campo correo -->
        <Label Text="Correo electrónico"
               FontSize="14"
               TextColor="White"
               Margin="0,0,0,5"/>

        <Frame BackgroundColor="White"
               BorderColor="#BDC3C7"
               CornerRadius="8"
               Padding="0"
               HasShadow="False">
            <Entry x:Name="CorreoEntry"
                   Placeholder="Ingrese su correo electrónico"
                   PlaceholderColor="#BDC3C7"
                   FontSize="14"
                   BackgroundColor="Transparent"
                   TextColor="#2C3E50"
                   Margin="12,10"
                   Keyboard="Email"/>
        </Frame>

        <!-- Botón enviar -->
        <Button Text="Enviar correo de recuperación"
                BackgroundColor="#3B82F6"
                TextColor="White"
                FontSize="15"
                FontAttributes="Bold"
                CornerRadius="8"
                HeightRequest="48"
                Margin="0,10,0,0"
                Clicked="OnEnviarClicked"/>

        <!-- Volver -->
        <Label Text="← Volver al inicio de sesión"
               FontSize="14"
               TextColor="#93C5FD"
               HorizontalOptions="Center"
               TextDecorations="Underline"
               Margin="0,8,0,0">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnVolverTapped"/>
            </Label.GestureRecognizers>
        </Label>

    </VerticalStackLayout>
</ContentPage>
