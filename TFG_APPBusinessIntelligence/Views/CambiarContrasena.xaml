<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TFG_APPBusinessIntelligence.Views.CambiarContrasena"
             Shell.NavBarIsVisible="False">
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1E3A8A" Offset="0.0" />
            <GradientStop Color="#0F172A" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Spacing="16"
                             Padding="30"
                             VerticalOptions="Center"
                             HorizontalOptions="Fill">

            <!-- Icono -->
            <Label Text="🔒"
                   FontSize="52"
                   HorizontalOptions="Center"
                   Margin="0,10,0,0"/>

            <!-- Título -->
            <Label Text="Cambiar contraseña"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,10"/>

            <!-- Contraseña actual -->
            <Label Text="Contraseña actual"
                   FontSize="14"
                   TextColor="White"
                   Margin="0,0,0,4"/>

            <Frame BackgroundColor="White"
                   BorderColor="#BDC3C7"
                   CornerRadius="8"
                   Padding="0"
                   HasShadow="False">
                <Entry x:Name="ContrasenaActualEntry"
                       Placeholder="Introduce tu contraseña actual"
                       PlaceholderColor="#BDC3C7"
                       FontSize="14"
                       BackgroundColor="Transparent"
                       TextColor="#2C3E50"
                       Margin="12,10"
                       IsPassword="True"/>
            </Frame>

            <!-- Nueva contraseña -->
            <Label Text="Nueva contraseña"
                   FontSize="14"
                   TextColor="White"
                   Margin="0,8,0,4"/>

            <Frame BackgroundColor="White"
                   BorderColor="#BDC3C7"
                   CornerRadius="8"
                   Padding="0"
                   HasShadow="False">
                <Entry x:Name="ContrasenaNewEntry"
                       Placeholder="Mínimo 6 caracteres"
                       PlaceholderColor="#BDC3C7"
                       FontSize="14"
                       BackgroundColor="Transparent"
                       TextColor="#2C3E50"
                       Margin="12,10"
                       IsPassword="True"/>
            </Frame>

            <!-- Confirmar nueva contraseña -->
            <Label Text="Confirmar nueva contraseña"
                   FontSize="14"
                   TextColor="White"
                   Margin="0,8,0,4"/>

            <Frame BackgroundColor="White"
                   BorderColor="#BDC3C7"
                   CornerRadius="8"
                   Padding="0"
                   HasShadow="False">
                <Entry x:Name="ContrasenaConfirmEntry"
                       Placeholder="Repite la nueva contraseña"
                       PlaceholderColor="#BDC3C7"
                       FontSize="14"
                       BackgroundColor="Transparent"
                       TextColor="#2C3E50"
                       Margin="12,10"
                       IsPassword="True"/>
            </Frame>

            <!-- Botón guardar -->
            <Button Text="Guardar nueva contraseña"
                    BackgroundColor="#22C55E"
                    TextColor="White"
                    FontSize="15"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="48"
                    Margin="0,16,0,0"
                    Clicked="OnGuardarClicked"/>

            <!-- Volver -->
            <Button Text="Cancelar"
                    BackgroundColor="#475569"
                    TextColor="White"
                    FontSize="14"
                    CornerRadius="8"
                    HeightRequest="44"
                    Clicked="OnCancelarClicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
