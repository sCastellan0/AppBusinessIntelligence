<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TFG_APPBusinessIntelligence.Views.NotificacionDialog"
             BackgroundColor="#80000000"
             NavigationPage.HasNavigationBar="False">

    <Grid VerticalOptions="Center" 
          HorizontalOptions="Center"
          Padding="20">

        <Frame CornerRadius="20"
               Padding="30"
               HasShadow="True"
               WidthRequest="350"
               MaximumWidthRequest="400">
            <Frame.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1E293B" Offset="0.0" />
                    <GradientStop Color="#0F172A" Offset="1.0" />
                </LinearGradientBrush>
            </Frame.Background>

            <VerticalStackLayout Spacing="20">

                <!-- Icono dinámico -->
                <Label x:Name="IconoLabel"
                       Text="✓"
                       FontSize="70"
                       TextColor="#10B981"
                       HorizontalOptions="Center"
                       FontAttributes="Bold"/>

                <!-- Título -->
                <Label x:Name="TituloLabel"
                       Text="Éxito"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>

                <!-- Mensaje -->
                <Label x:Name="MensajeLabel"
                       Text="Operación completada correctamente"
                       TextColor="#94A3B8"
                       FontSize="15"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"/>

                <!-- Detalle adicional (opcional) -->
                <Frame x:Name="DetalleFrame"
                       IsVisible="False"
                       CornerRadius="12"
                       Padding="15"
                       BackgroundColor="#334155"
                       BorderColor="Transparent"
                       HasShadow="False">
                    <Label x:Name="DetalleLabel"
                           TextColor="#E2E8F0"
                           FontSize="13"
                           LineBreakMode="WordWrap"
                           HorizontalTextAlignment="Center"/>
                </Frame>

                <!-- Botón Aceptar -->
                <Button x:Name="AceptarBtn"
                        Text="Aceptar"
                        Clicked="OnAceptarClicked"
                        HeightRequest="50"
                        CornerRadius="12"
                        FontSize="16"
                        FontAttributes="Bold"
                        Margin="0,10,0,0">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#3B82F6" Offset="0.0" />
                            <GradientStop Color="#60A5FA" Offset="1.0" />
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>

            </VerticalStackLayout>
        </Frame>
    </Grid>
</ContentPage>
