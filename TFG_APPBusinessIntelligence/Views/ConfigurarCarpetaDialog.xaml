<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TFG_APPBusinessIntelligence.Views.ConfigurarCarpetaDialog"
             BackgroundColor="#80000000"
             NavigationPage.HasNavigationBar="False">

    <Grid VerticalOptions="Center" 
          HorizontalOptions="Center"
          Padding="20">

        <Frame CornerRadius="20"
               Padding="30"
               HasShadow="True"
               WidthRequest="350"
               MaximumWidthRequest="400">
            <Frame.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1E293B" Offset="0.0" />
                    <GradientStop Color="#0F172A" Offset="1.0" />
                </LinearGradientBrush>
            </Frame.Background>

            <VerticalStackLayout Spacing="20">

                <!-- Icono -->
                <Label Text="📁"
                       FontSize="60"
                       HorizontalOptions="Center"/>

                <!-- Título -->
                <Label Text="Configurar Carpeta de Informes"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>

                <!-- Mensaje -->
                <Label TextColor="#94A3B8"
                       FontSize="15"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Para guardar los informes generados, necesitas seleccionar una carpeta en tu dispositivo."/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!-- Nota adicional -->
                <Label Text="Podrás cambiar esta configuración en cualquier momento desde Ajustes."
                       TextColor="#64748B"
                       FontSize="13"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"
                       Margin="0,10,0,0"/>

                <!-- Botones -->
                <VerticalStackLayout Spacing="12" Margin="0,20,0,0">

                    <!-- Botón Seleccionar Carpeta -->
                    <Button Text="Seleccionar Carpeta"
                            Clicked="OnSeleccionarCarpetaClicked"
                            HeightRequest="50"
                            CornerRadius="12"
                            FontSize="16"
                            FontAttributes="Bold">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#3B82F6" Offset="0.0" />
                                <GradientStop Color="#60A5FA" Offset="1.0" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>

                    <!-- Botón Más Tarde -->
                    <Button Text="Configurar Más Tarde"
                            Clicked="OnMasTardeClicked"
                            HeightRequest="45"
                            CornerRadius="12"
                            FontSize="14"
                            TextColor="#94A3B8"
                            BackgroundColor="#334155"/>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </Frame>
    </Grid>
</ContentPage>
