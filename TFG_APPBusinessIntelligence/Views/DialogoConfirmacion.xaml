<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TFG_APPBusinessIntelligence.Views.DialogoConfirmacion"
             BackgroundColor="Transparent"
             Shell.NavBarIsVisible="False">

    <Grid>
        <!-- Contenedor del diálogo -->
        <Frame WidthRequest="320"
               HeightRequest="240"
               CornerRadius="16"
               HasShadow="True"
               VerticalOptions="Center"
               HorizontalOptions="Center"
               Padding="0"
               BorderColor="{DynamicResource TemaBorde}">

            <Frame.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1E3A8A" Offset="0.0" />
                    <GradientStop Color="#0F172A" Offset="1.0" />
                </LinearGradientBrush>
            </Frame.Background>

            <Grid RowDefinitions="Auto,*,Auto" Padding="24,20">

                <!-- Icono y título -->
                <VerticalStackLayout Grid.Row="0" Spacing="8" Margin="0,0,0,12">
                    <Label Text="⚠️" 
                           FontSize="42"
                           HorizontalOptions="Center" />
                    <Label x:Name="TituloLabel"
                           Text="Proceso en curso"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Mensaje -->
                <ScrollView Grid.Row="1" VerticalOptions="FillAndExpand">
                    <Label x:Name="MensajeLabel"
                           Text="El informe se está generando. Si sales ahora, recibirás una notificación cuando termine."
                           FontSize="14"
                           TextColor="#94A3B8"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap" />
                </ScrollView>

                <!-- Botones -->
                <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,16,0,0">

                    <!-- Botón Cancelar -->
                    <Button Grid.Column="0"
                            x:Name="BotonCancelar"
                            Text="Cancelar"
                            BackgroundColor="Transparent"
                            BorderColor="{DynamicResource TemaBorde}"
                            BorderWidth="1.5"
                            TextColor="{DynamicResource TemaSubtexto}"
                            CornerRadius="10"
                            FontSize="14"
                            FontAttributes="Bold"
                            HeightRequest="46"
                            Clicked="OnCancelarClicked" />

                    <!-- Botón Confirmar -->
                    <Button Grid.Column="1"
                            x:Name="BotonConfirmar"
                            Text="Salir"
                            BackgroundColor="{DynamicResource TemaAccent}"
                            TextColor="White"
                            CornerRadius="10"
                            FontSize="14"
                            FontAttributes="Bold"
                            HeightRequest="46"
                            Clicked="OnConfirmarClicked" />

                </Grid>

            </Grid>
        </Frame>
    </Grid>

</ContentPage>
